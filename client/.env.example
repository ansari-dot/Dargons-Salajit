# Base URL of the Express API (client)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# PKR → USD rate used when a visitor is outside Pakistan.
# Storefront prices are stored in the database in PKR (base currency).
# NOTE: only USD is configured here. Every other currency (AED, SAR, QAR, KWD,
# BHD, OMR, and the rest of the Arab currencies) gets its LIVE rate from the
# backend — `GET /api/location` → `location.exchangeRate` / `location.rates`,
# sourced from open.er-api.com (PKR based, cached 10 minutes).
# The static table in `lib/utils/currency.ts` is only an offline fallback.
NEXT_PUBLIC_USD_TO_PKR_RATE=278
